# Meta Model API (Llama / Muse endpoints)
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
# Optional model overrides (defaults: muse-spark-1.1 chat, muse-voice-transcribe-1.0 STT)
MUSE_CHAT_MODEL=
MUSE_STT_MODEL=

# Supabase Postgres & Realtime (Server-side service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Facebook App Credentials & Webhook Handshake
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
FB_VERIFY_TOKEN=your-webhook-verification-token

# AES-256-GCM Token Encryption Key (Optional, 32-byte key or derived from FB_APP_SECRET)
TOKEN_ENCRYPTION_KEY=

# API key required by all /api/* endpoints when set (send as `x-api-key`
# header or `Authorization: Bearer`). Local dev stays open without it;
# production refuses /api/* requests until it is configured.
API_KEY=

# Comma-separated origins allowed for browser CORS and OAuth redirect_uri
# validation. Leave unset for localhost-only development.
ALLOWED_ORIGINS=https://your-app.example.com
ALLOWED_REDIRECT_ORIGINS=https://your-app.example.com

# Server Port
PORT=3000

# Real API data auto-expiry (minutes). Rows from the Meta Graph API /
# webhook pipeline (conversations, messages, pending_actions,
# conversation_sessions) older than this are auto-deleted by the system.
# Dummy / sample content is frontend-only and never stored, so it never
# expires. Persistent tables (pages, users, products) never expire.
# Defaults to 10 when unset.
REAL_DATA_TTL_MINUTES=10
