# Mume environment template — copy to `.env` and fill in your own values.
# NEVER commit a filled-in `.env` file. Every value below is a placeholder.
#
# --- Backend (Node + Express) ---
# Meta Model API (Llama / Muse endpoints)
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.dev.meta.ai

# Supabase (server uses the service_role key; NEVER expose it to clients)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Facebook App Credentials & Webhook Handshake
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
FB_VERIFY_TOKEN=your-webhook-verification-token

# AES-256-GCM Token Encryption Key (optional; derived from FB_APP_SECRET if unset)
TOKEN_ENCRYPTION_KEY=

# API key required by all /api/* endpoints when set. Local dev stays open
# without it; production refuses /api/* requests until it is configured.
API_KEY=

# Comma-separated origins allowed for browser CORS and OAuth redirect_uri
# validation. Leave unset for localhost-only development.
ALLOWED_ORIGINS=https://your-app.example.com
ALLOWED_REDIRECT_ORIGINS=https://your-app.example.com

PORT=3000

# --- Web companion (Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Live backend is https://mume-backend.onrender.com/ (use http://localhost:3000 for local dev)
VITE_API_URL=http://localhost:3000
VITE_API_KEY=

# --- Mobile app (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Live backend is https://mume-backend.onrender.com/ (use http://localhost:3000 for local dev)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_KEY=
