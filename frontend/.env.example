# Mume Mobile Frontend Environment Configuration
# API URL of the deployed or local Express backend
# Live backend: https://mume-backend.onrender.com/
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase Project Credentials (Anon Public Key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API key (must match the backend API_KEY when it is enforced)
EXPO_PUBLIC_API_KEY=
